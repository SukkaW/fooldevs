{
  "name": "fooldevs",
  "version": "0.1.1",
  "description": "A tool that fools all kinds of devtools detection.",
  "repository": {
    "url": "https://github.com/SukkaW/fooldevs"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "browser": "./dist/index.umd.min.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.mjs",
      "require": "./dist/react.cjs",
      "default": "./dist/react.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "eslint . --format=sukka",
    "example": "parcel ./example/index.html",
    "build": "rollup -c rollup.config.ts --bundleConfigAsCjs --configPlugin swc3",
    "codegen": "SWC_NODE_IGNORE_DYNAMIC=true LATEST_VERSION_SCRIPT=true node -r @swc-node/register scripts/codegen.ts",
    "prerelease": "pnpm run lint && pnpm run build",
    "release": "bumpp -r --all --commit \"release: %s\" --tag \"%s\""
  },
  "keywords": [
    "wappalyzer"
  ],
  "author": "Sukka <https://skk.moe>",
  "license": "MIT",
  "devDependencies": {
    "@eslint-sukka/node": "^8.0.1",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-replace": "^6.0.2",
    "@swc-node/register": "^1.11.1",
    "@swc/core": "^1.13.5",
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.2",
    "bumpp": "^10.3.1",
    "cli-progress": "^3.12.0",
    "eslint": "^9.38.0",
    "eslint-config-sukka": "^8.0.1",
    "eslint-formatter-sukka": "^8.0.1",
    "foxts": "^5.0.0",
    "is-ci": "^4.1.0",
    "parcel": "^2.16.0",
    "rollup": "^4.52.5",
    "rollup-plugin-dts": "^6.2.3",
    "rollup-plugin-oxc-resolve": "^0.0.5",
    "rollup-plugin-swc3": "^0.12.1",
    "rollup-preserve-directives": "^1.1.3",
    "ts-dedent": "^2.2.0",
    "typescript": "^5.9.3"
  },
  "@parcel/resolver-default": {
    "packageExports": true
  },
  "targets": {
    "main": false,
    "types": false
  },
  "packageManager": "pnpm@10.19.0"
}
