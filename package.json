{
  "name": "fooldevs",
  "version": "0.0.1-beta.3",
  "description": "A tool that fools all kinds of devtools detection.",
  "main": "./dist/cjs/index.js",
  "module": "./dist/es/index.mjs",
  "types": "./dist/cjs/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/es/index.d.mts",
        "default": "./dist/es/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/es/react.d.mts",
        "default": "./dist/es/react.mjs"
      },
      "require": {
        "types": "./dist/cjs/react.d.ts",
        "default": "./dist/cjs/react.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "eslint . --format=sukka",
    "build": "bunchee -m",
    "version": "node -r @swc-node/register scripts/get-version.ts",
    "release": "bumpp -r --all --commit \"release: %s\" --tag \"%s\""
  },
  "keywords": [
    "wappalyzer"
  ],
  "author": "Sukka <https://skk.moe>",
  "license": "MIT",
  "devDependencies": {
    "@eslint-sukka/node": "^5.1.2",
    "@swc-node/register": "^1.9.2",
    "@swc/core": "^1.6.3",
    "@types/node": "^20.14.6",
    "bumpp": "^9.4.1",
    "bunchee": "^5.2.1",
    "eslint": "^9.5.0",
    "eslint-config-sukka": "6.0.0-beta.25",
    "eslint-formatter-sukka": "6.0.0-beta.25",
    "latest-version": "5.1.0",
    "typescript": "^5.4.5"
  },
  "packageManager": "pnpm@9.4.0"
}
